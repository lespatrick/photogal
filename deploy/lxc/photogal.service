[Unit]
Description=photogal - Photography Presentation & Selection Platform
After=network.target

[Service]
Type=simple
User=photogal
Group=photogal
WorkingDirectory=/opt/photogal/.next/standalone
EnvironmentFile=-/opt/photogal/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
Environment=NEXT_TELEMETRY_DISABLED=1

ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
KillSignal=SIGINT

# Security sandbox
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=-/opt/photogal/data -/opt/photogal/storage -/opt/photogal/.next/standalone -/mnt -/media

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
