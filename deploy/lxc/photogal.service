[Unit]
Description=photogal - Photography Presentation & Selection Platform
After=network.target

[Service]
Type=simple
User=photogal
Group=photogal
WorkingDirectory=/opt/photogal
EnvironmentFile=-/opt/photogal/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
Environment=NEXT_TELEMETRY_DISABLED=1

ExecStart=/opt/photogal/deploy/lxc/start.sh
Restart=always
RestartSec=5
KillSignal=SIGINT

# Security sandbox & limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
